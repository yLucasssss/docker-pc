# Prática 03 — primeira imagem própria
FROM node:20-alpine

WORKDIR /app

# Copiado antes do restante do código para aproveitar o cache de camadas:
# só reinstala dependências quando package.json mudar.
COPY app/package.json ./
RUN npm install --omit=dev

COPY app/server.js ./

ENV PORTA=3000
EXPOSE 3000

CMD ["node", "server.js"]

HEALTHCHECK --interval=2s --timeout=2s CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
